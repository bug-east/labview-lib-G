[DebugConsole.historyView]
History Length = 50    
History 0 = "API: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:3000} ->| Range Check"
History 1 = "Macro: Range check ->| Range check"
History 2 = "Macro: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:3000} ->| Range check"
History 3 = "API: API1 >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:3000} ->| Event CSM"
History 4 = "Macro: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:3000} -@ Range check"
History 5 = "API: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:3000} -@ Range check"
History 6 = "API: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:2000;超时时间ms:2000} -@ Range check"
History 7 = "API: Range check >> {设定值上限:10;设定值下限:1;设定时间ms:1000;超时时间ms:2000} -@ Range check"
History 8 = "API: Timing >> 1200 -@ Timer"

